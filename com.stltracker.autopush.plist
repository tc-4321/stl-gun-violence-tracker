<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stltracker.autopush</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/thomascrees/Downloads/stl-tracker/push.sh</string>
    </array>

    <!-- Runs every day at 6:30 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/thomascrees/Downloads/stl-tracker/autopush.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/thomascrees/Downloads/stl-tracker/autopush.log</string>
</dict>
</plist>
